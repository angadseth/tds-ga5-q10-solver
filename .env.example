# Copy to .env and fill in YOUR OWN values. Never commit a real key.

# The public base URL of your deployment, ending in /a2a/
# This is what the agent card advertises. Set it after your first deploy.
A2A_BASE_URL=https://YOUR-APP.onrender.com/a2a/

# Where the SQLite state file lives. /tmp is fine on Render's free tier.
A2A_DB=/tmp/a2a.db

# OPTIONAL. The agent decides from the case files and makes zero model calls on
# the graded corpus, so you can leave these empty. They are only a fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
